# =============================================================================
# BioSense-GovAI — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Supabase (Postgres + pgvector + Auth) ---
# Project Settings → Database → Connection string (URI, Session mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Next.js public Supabase (same project) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional local Postgres (docker compose --profile local-db) ---
POSTGRES_USER=biosense
POSTGRES_PASSWORD=biosense_dev_change_me
POSTGRES_DB=biosense
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=biosense_dev_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- FastAPI ---
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
LOG_LEVEL=INFO

# --- Next.js (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
API_URL=http://127.0.0.1:8000

# --- OpenAI ---
OPENAI_API_URL=
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Korean Public Data (optional — falls back to seed JSON) ---
KOSIS_API_KEY=
KDCA_API_URL=
KDCA_API_KEY=

# --- Ingestion pipeline ---
INGESTION_SCHEDULER_ENABLED=true
INGESTION_CRON_HOUR=3
INGESTION_CACHE_TTL_HOURS=24
INGESTION_RETRY_MAX_ATTEMPTS=3

# --- Deployment (Railway / Vercel) ---
# RAILWAY_TOKEN=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
